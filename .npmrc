# PNPM Configuration
# This ensures consistent behavior across different environments

# Use the global pnpm store (saves disk space)
store-dir=~/.pnpm-store

# Strict dependency installation
# This ensures that only dependencies listed in package.json are accessible
strict-peer-dependencies=true

# Auto-install peers (set to false for stricter control)
auto-install-peers=false

# Create a flat node_modules structure when possible
# This helps with compatibility for tools that expect traditional node_modules
shamefully-hoist=true

# Use symlinks for workspace packages
link-workspace-packages=true

# Save exact versions to the lockfile
save-exact=false
save-prefix=^

# Network settings
network-timeout=60000

# Fail on missing peer dependencies
# This helps catch dependency issues early
peer-dependency-rules.allowedVersions:
  react: 18
  react-dom: 18